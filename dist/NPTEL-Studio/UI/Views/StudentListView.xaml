<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="32,20,32,20">
        <Grid.RowDefinitions>
            <!-- 0. Header (Title + Back Button on Top Right) -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Staged Push Action Bar (Optional, visible when unapproved) -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Search & Pagination Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Students Table -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- VIEW HEADER (Top-Right Back to Stage 1 Button)                -->
        <!-- ============================================================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Breadcrumb + Title + Subtitle -->
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="TxtVerifiedBreadcrumb"
                           Text="COURSES &#x2014; STAGE 1 &#x2014; VERIFIED STUDENTS"
                           FontFamily="IBM Plex Mono, Consolas"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="{DynamicResource SageBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtVerifiedCourseTitle"
                           Text="Stage 1 Verified Students Roster"
                           FontFamily="Segoe UI, Inter, sans-serif"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"/>
                <TextBlock Text="Students with verified fee payment receipts and confirmed registration choice."
                           FontSize="12"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Right: Verified Count Badge + Back Button on Top Right -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource Panel2Brush}"
                        BorderBrush="{DynamicResource SageBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        Margin="0,0,12,0">
                    <TextBlock x:Name="TxtVerifiedHeaderCount"
                               Text="0 Verified Students"
                               FontFamily="IBM Plex Mono, Consolas"
                               FontSize="12"
                               Foreground="{DynamicResource SageBrush}"/>
                </Border>
                <Button x:Name="BtnBackToStage1FromStudentList"
                        Content="&#x2190; Back to Stage 1"
                        Style="{DynamicResource BtnSecondary}"
                        Padding="16,8"
                        FontSize="12"
                        FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <!-- ============================================================= -->
        <!-- STAGED UNAPPROVED PUSH ACTION BAR (Row 1)                     -->
        <!-- Appears when coordinator unapproves a verified student        -->
        <!-- ============================================================= -->
        <Border x:Name="PanelStagedUnapprovedPushBar"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="{DynamicResource Panel2Brush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtStagedUnapprovedNotice"
                               Text="1 student marked for unapproval."
                               FontFamily="IBM Plex Mono, Consolas"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text=" &#x2014; Click Push to save changes to the verification sheet."
                               FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="6,0,0,0"/>
                </StackPanel>
                <Button x:Name="BtnPushStage1VerifiedChanges"
                        Grid.Column="1"
                        Content="&#x2713; Push Changes to Main Sheet"
                        Style="{DynamicResource BtnPrimary}"
                        Padding="14,6"
                        FontSize="11"/>
            </Grid>
        </Border>

        <!-- ============================================================= -->
        <!-- SEARCH & PAGINATION TOOLBAR (Row 2)                           -->
        <!-- ============================================================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBox x:Name="TxtSearchVerifiedStudent"
                         Grid.Column="0"
                         Style="{DynamicResource InputDark}"
                         Padding="10,6"
                         FontSize="12"
                         ToolTip="Filter verified students by Roll No or Name"/>

                <!-- Middle: Page Range Indicator -->
                <TextBlock x:Name="TxtVerifiedPageRange"
                           Grid.Column="1"
                           Text="Showing 1-25 of 0"
                           FontFamily="IBM Plex Mono, Consolas"
                           FontSize="11"
                           Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,16,0"/>

                <!-- Right: Pagination Buttons & Export -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnVerifiedPrevPage"
                            Content="&#x2039; Prev"
                            Style="{DynamicResource BtnSecondary}"
                            Padding="10,5"
                            FontSize="11"
                            Margin="0,0,6,0"/>
                    <Button x:Name="BtnVerifiedNextPage"
                            Content="Next &#x203A;"
                            Style="{DynamicResource BtnSecondary}"
                            Padding="10,5"
                            FontSize="11"
                            Margin="0,0,12,0"/>
                    <Button x:Name="BtnExportVerifiedCsv"
                            Content="&#x1F4C4; Export CSV"
                            Style="{DynamicResource BtnSecondary}"
                            Padding="12,5"
                            FontSize="11"
                            ToolTip="Export list of verified students to CSV"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================= -->
        <!-- STUDENTS TABLE CONTAINER (Row 3)                              -->
        <!-- ============================================================= -->
        <Border Grid.Row="3"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Table Header Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Scrollable Rows Host -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table Header Grid -->
                <Grid Grid.Row="0" Margin="12,0,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="ENROLLMENT NO" FontFamily="IBM Plex Mono, Consolas" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Grid.Column="1" Text="STUDENT NAME" FontFamily="IBM Plex Mono, Consolas" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Grid.Column="2" Text="PAYMENT STATUS &amp; FEE" FontFamily="IBM Plex Mono, Consolas" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SageBrush}"/>
                    <TextBlock Grid.Column="3" Text="RECEIPT PROOF" FontFamily="IBM Plex Mono, Consolas" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Grid.Column="4" Text="ACTIONS" FontFamily="IBM Plex Mono, Consolas" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/>
                </Grid>

                <Border Grid.Row="0" VerticalAlignment="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,0"/>

                <!-- Dynamic Student Rows Host -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>
                        <!-- List of dynamic student row cards -->
                        <StackPanel x:Name="VerifiedStudentsTableHost"/>

                        <!-- Empty State Notice -->
                        <Border x:Name="VerifiedEmptyNotice"
                                Visibility="Collapsed"
                                Background="{DynamicResource Panel2Brush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20,40"
                                Margin="0,20,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="No Verified Students Found"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="Students will appear here once receipts are verified via OCR or manually approved in the Review queue."
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

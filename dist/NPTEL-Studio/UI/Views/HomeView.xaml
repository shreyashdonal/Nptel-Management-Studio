<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="780" Margin="32,40,32,60" HorizontalAlignment="Center">

            <!-- ======================================================== -->
            <!-- STATE 1: HOME WELCOME / LAUNCHER (Default Visible)       -->
            <!-- ======================================================== -->
            <StackPanel x:Name="PanelHomeWelcome" Visibility="Visible">

                <!-- Hero Section -->
                <StackPanel Margin="0,0,0,36" HorizontalAlignment="Center">
                    <TextBlock Text="NPTEL ELECTIVE OPERATIONS"
                               FontFamily="IBM Plex Mono, Consolas"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Elective Management Studio"
                               FontFamily="IBM Plex Mono, Consolas"
                               FontSize="32"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="Automate routine student elective verification and streamline the full semester lifecycle from registration to final NPTEL exam results."
                               FontSize="14"
                               Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="600"/>
                </StackPanel>

                <!-- Action Launch Cards (2 Options) -->
                <Grid Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Register Course Action -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="28">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Width="36" Height="36"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,16">
                                <TextBlock Text="+"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Row="1"
                                       Text="Register New Course"
                                       FontFamily="IBM Plex Mono, Consolas"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="2"
                                       Text="Start a course workspace by uploading the student registration sheet. Auto-verify course choices and fee receipts immediately."
                                       FontSize="13"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,24"/>

                            <Button x:Name="BtnStartRegistration"
                                    Grid.Row="3"
                                    Content="+ Register Course"
                                    Style="{DynamicResource BtnPrimary}"
                                    Padding="18,11"
                                    HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Border>

                    <!-- Card 2: View Existing Courses -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="28">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Width="36" Height="36"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,16">
                                <TextBlock Text="&gt;"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Row="1"
                                       Text="Managed Courses"
                                       FontFamily="IBM Plex Mono, Consolas"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="2"
                                       Text="Browse all active courses, review student discrepancies, or upload exam results when published after 5-6 months."
                                       FontSize="13"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,24"/>

                            <Button x:Name="BtnBrowseCoursesFromHome"
                                    Grid.Row="3"
                                    Content="View Courses -&gt;"
                                    Style="{DynamicResource BtnSecondary}"
                                    Padding="18,11"
                                    HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ======================================================== -->
                <!-- GOOGLE FORM TEMPLATES & DATA COLLECTION (STAGE 1 & 2)    -->
                <!-- ======================================================== -->
                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="24"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Section Header -->
                        <Grid Margin="0,0,0,20">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DATA COLLECTION &amp; FORM TEMPLATES"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="NPTEL Student Forms"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <Button x:Name="BtnViewFormGuidelines"
                                    Content="&#x2139; View Student Instructions &#x25BE;"
                                    Style="{DynamicResource BtnSecondary}"
                                    Padding="14,7"
                                    FontSize="11"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Two Form Cards: Stage 1 and Stage 2 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Stage 1 Registration & Receipt Form -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Stage 1 Pill & Status -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="4" Padding="7,3" Margin="0,0,8,0">
                                            <TextBlock Text="STAGE 1: REGISTRATION" FontFamily="IBM Plex Mono" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Title -->
                                    <TextBlock Grid.Row="1"
                                               Text="Registration &amp; Enrollment Form"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="0,0,0,8"/>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="2"
                                               Text="Collects student roll numbers, elective choices, payment status, and fee receipts at the beginning of the semester."
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,16"/>

                                    <!-- Key Schema Tags -->
                                    <WrapPanel Grid.Row="3" Margin="0,0,0,18">
                                        <Border Background="{DynamicResource PanelModBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                            <TextBlock Text="Enrollment No" FontFamily="IBM Plex Mono" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                        </Border>
                                        <Border Background="{DynamicResource PanelModBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                            <TextBlock Text="Student Name" FontFamily="IBM Plex Mono" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                        </Border>
                                        <Border Background="{DynamicResource PanelModBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                            <TextBlock Text="Subject / Elective" FontFamily="IBM Plex Mono" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                        </Border>
                                        <Border Background="{DynamicResource PanelModBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                            <TextBlock Text="Fee Amount (&#x20B9;1000/500)" FontFamily="IBM Plex Mono" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                        </Border>
                                        <Border Background="{DynamicResource PanelModBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                            <TextBlock Text="Receipt PDF / Image" FontFamily="IBM Plex Mono" FontSize="10" Foreground="{DynamicResource SageBrush}"/>
                                        </Border>
                                    </WrapPanel>

                                    <!-- Action Buttons -->
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnOpenStage1Form"
                                                Grid.Column="0"
                                                Content="&#x1F517; Open Form"
                                                Style="{DynamicResource BtnPrimary}"
                                                Padding="14,9"
                                                FontSize="12"
                                                ToolTip="Open the Stage 1 Registration Google Form in your browser"/>
                                        <Button x:Name="BtnCopyStage1Form"
                                                Grid.Column="2"
                                                Content="&#x1F4CB; Copy Link"
                                                Style="{DynamicResource BtnSecondary}"
                                                Padding="12,9"
                                                FontSize="12"
                                                ToolTip="Copy Stage 1 Google Form link to clipboard"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Card 2: Stage 2 Exam Results & Certificate Form -->
                            <Border Grid.Column="2"
                                    Background="{DynamicResource Panel2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Stage 2 Pill & Status -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Background="{DynamicResource SageTintBrush}" CornerRadius="4" Padding="7,3" Margin="0,0,8,0">
                                            <TextBlock Text="STAGE 2: RESULTS" FontFamily="IBM Plex Mono" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SageBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Title -->
                                    <TextBlock Grid.Row="1"
                                               Text="NPTEL Result &amp; Certificate Form"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="0,0,0,8"/>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="2"
                                               Text="Collects e-certificates and exact printed marks (Assignment /25, Exam /75, Total /100) after exam results are released."
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,16"/>

                                    <!-- Key Schema Tags -->
                                    <WrapPanel Grid.Row="3" Margin="0,0,0,18">
                                        <Border Background="{DynamicResource PanelModBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                            <TextBlock Text="Enrollment No" FontFamily="IBM Plex Mono" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                        </Border>
                                        <Border Background="{DynamicResource PanelModBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                            <TextBlock Text="Candidate Name" FontFamily="IBM Plex Mono" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                        </Border>
                                        <Border Background="{DynamicResource PanelModBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                            <TextBlock Text="Assign (/25)" FontFamily="IBM Plex Mono" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                        </Border>
                                        <Border Background="{DynamicResource PanelModBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                            <TextBlock Text="Exam (/75)" FontFamily="IBM Plex Mono" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                        </Border>
                                        <Border Background="{DynamicResource PanelModBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                            <TextBlock Text="Total (/100)" FontFamily="IBM Plex Mono" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                        </Border>
                                        <Border Background="{DynamicResource PanelModBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                            <TextBlock Text="Certificate (PDF/JPG)" FontFamily="IBM Plex Mono" FontSize="10" Foreground="{DynamicResource SageBrush}"/>
                                        </Border>
                                    </WrapPanel>

                                    <!-- Action Buttons -->
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnOpenStage2Form"
                                                Grid.Column="0"
                                                Content="&#x1F517; Open Form"
                                                Style="{DynamicResource BtnPrimary}"
                                                Padding="14,9"
                                                FontSize="12"
                                                ToolTip="Open the Stage 2 Result Google Form in your browser"/>
                                        <Button x:Name="BtnCopyStage2Form"
                                                Grid.Column="2"
                                                Content="&#x1F4CB; Copy Link"
                                                Style="{DynamicResource BtnSecondary}"
                                                Padding="12,9"
                                                FontSize="12"
                                                ToolTip="Copy Stage 2 Google Form link to clipboard"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Expandable Guidelines & Student Instructions Panel -->
                        <Border x:Name="PanelFormInstructions"
                                Visibility="Collapsed"
                                Background="{DynamicResource Panel2Brush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="RECOMMENDED STUDENT INSTRUCTIONS FOR FORMS"
                                               FontFamily="IBM Plex Mono, Consolas"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="BtnCloseFormInstructions"
                                            Content="&#x2715; Close"
                                            Style="{DynamicResource BtnSecondary}"
                                            Padding="10,4"
                                            FontSize="10"
                                            HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Stage 1 Instructions Card -->
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource PanelModBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Stage 1: Receipt Upload Rules"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Text="&#x2022; File Name: &lt;Enrollment&gt;_receipt.pdf (or .jpg / .png)&#x0a;&#x2022; Fee Amount: Clearly show &#x20B9;1,000 / &#x20B9;1,100 / &#x20B9;500&#x0a;&#x2022; Status: Must state 'Payment Successful'&#x0a;&#x2022; Valid Proof: Official Swayam receipt or Razorpay invoice"
                                                       FontSize="11"
                                                       LineHeight="18"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       Margin="0,0,0,10"/>
                                            <Button x:Name="BtnCopyStage1Instructions"
                                                    Content="&#x1F4CB; Copy Stage 1 Notice Text"
                                                    Style="{DynamicResource BtnSecondary}"
                                                    Padding="8,5"
                                                    FontSize="11"
                                                    HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Stage 2 Instructions Card -->
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource PanelModBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Stage 2: Certificate Upload Rules"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Text="&#x2022; File Name: &lt;Enrollment&gt;_Certificate.pdf (or .jpeg / .png)&#x0a;&#x2022; Marks Entry: Exact printed values for Assign (/25), Exam (/75), Total (/100)&#x0a;&#x2022; No Rounding: Enter 24.67 (NOT 25)&#x0a;&#x2022; Valid Proof: Official e-Certificate only (No hall tickets)"
                                                       FontSize="11"
                                                       LineHeight="18"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       Margin="0,0,0,10"/>
                                            <Button x:Name="BtnCopyStage2Instructions"
                                                    Content="&#x1F4CB; Copy Stage 2 Notice Text"
                                                    Style="{DynamicResource BtnSecondary}"
                                                    Padding="8,5"
                                                    FontSize="11"
                                                    HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ======================================================== -->
            <!-- STATE 2: REGISTRATION FORM (Initial Phase: 1 Sheet)      -->
            <!-- ======================================================== -->
            <StackPanel x:Name="PanelRegisterForm" Visibility="Collapsed">

                <!-- Back Navigation Header -->
                <Grid Margin="0,0,0,24">
                    <Button x:Name="BtnBackFromRegister"
                            Content="&lt;- Back to Home"
                            Style="{DynamicResource BtnSecondary}"
                            Padding="12,6"
                            FontSize="12"
                            HorizontalAlignment="Left"/>
                    <TextBlock Text="Register New Course"
                               FontFamily="IBM Plex Mono, Consolas"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Form Card -->
                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="32"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Section A: Course Details -->
                        <TextBlock Text="COURSE DETAILS"
                                   FontFamily="IBM Plex Mono, Consolas"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,0,16"/>

                        <!-- Course Title -->
                        <TextBlock Text="Course Title"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtCourseName"
                                 Style="{DynamicResource InputDark}"
                                 Margin="0,0,0,16"/>

                        <!-- Course Code -->
                        <TextBlock Text="NPTEL Course Code / ID"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtCourseCode"
                                 Style="{DynamicResource InputDark}"
                                 FontFamily="IBM Plex Mono, Consolas"
                                 Margin="0,0,0,16"/>

                        <!-- Department & Semester -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Department"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtDepartment"
                                         Style="{DynamicResource InputDark}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Semester / Academic Term"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtSemester"
                                         Style="{DynamicResource InputDark}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Divider -->
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,24"/>

                        <!-- Section B: Initial Single Sheet Upload -->
                        <TextBlock Text="STUDENT REGISTRATION SPREADSHEET"
                                   FontFamily="IBM Plex Mono, Consolas"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Attach the initial student registration sheet to begin verifying choices and payment receipts."
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,0,0,18"/>

                        <!-- Single Sheet Picker -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Student Enrollment &amp; Registration Sheet (Excel / CSV)"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Google Form responses or college enrollment sheet with Roll No, Course, and Receipt proof."
                                       FontSize="11"
                                       Foreground="{DynamicResource Muted2Brush}"
                                       Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtRegistrationSheetPath"
                                         Style="{DynamicResource InputDark}"
                                         Grid.Column="0"
                                         FontSize="12"/>
                                <Button x:Name="BtnBrowseRegistrationSheet"
                                        Grid.Column="2"
                                        Content="Browse File..."
                                        Style="{DynamicResource BtnSecondary}"
                                        Padding="14,8"/>
                            </Grid>
                        </StackPanel>

                        <!-- Notice about Exam Results in 5-6 Months -->
                        <Border Background="{DynamicResource Panel2Brush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14"
                                Margin="0,0,0,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="i" FontFamily="IBM Plex Mono" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="Looking for Exam Results? NPTEL exam results will be uploaded later inside this course workspace after students write exams in 5-6 months."
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <!-- Form Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnCreateCourse"
                                    Grid.Column="0"
                                    Content="+ Add Course &amp; Start Verification"
                                    Style="{DynamicResource BtnPrimary}"
                                    Padding="22,12"
                                    FontSize="13"/>
                            <Button x:Name="BtnCancelRegister"
                                    Grid.Column="2"
                                    Content="Cancel"
                                    Style="{DynamicResource BtnSecondary}"
                                    Padding="20,12"
                                    FontSize="13"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
